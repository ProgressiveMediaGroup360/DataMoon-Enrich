# Railway service variables (never commit real values)
ACCESS_TOKEN=            # 24+ random characters; the app lives at /s/<ACCESS_TOKEN>/
DATAMOON_API_KEY=        # Datamoon API key
QC_WEBHOOK_URL=          # production URL of the n8n "Pre-QC (API)" webhook (leave empty to skip QC for now)
QC_WEBHOOK_TOKEN=        # the Header Auth secret you set on that webhook
DATA_DIR=/data           # attach a Railway volume here to keep results + cache across deploys
RETENTION_DAYS=7
RATE_LIMIT_COOLDOWN_SEC=60
MAX_ROWS_PER_JOB=10000
MAX_UPLOAD_MB=20
MAX_JOBS_PER_HOUR=20
MAX_JOBS_PER_IP_HOUR=5
WORKERS=2
